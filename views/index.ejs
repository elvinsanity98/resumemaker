<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ResumeForge — ATS-Ready Resume Builder</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
  <style>
    html, body { height: 100%; }
    .preview-frame { border: none; width: 100%; height: 100%; }
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 99px; }
    .tab-btn.active { background: white; box-shadow: 0 1px 3px rgba(0,0,0,.08); color: #4338ca; }
    .ats-ring { transition: stroke-dashoffset 0.6s ease; }
    .skill-tag { display:inline-flex; align-items:center; gap:4px; background:#eef2ff; color:#4338ca;
                 padding:2px 10px; border-radius:99px; font-size:12px; font-weight:500; margin:2px; }
    .skill-tag button { background:none;border:none;cursor:pointer;color:#818cf8;font-size:14px;
                        line-height:1;padding:0 2px; }
    .skill-tag button:hover { color:#dc2626; }

    /* Desktop layout */
    @media (min-width: 1024px) {
      .main-layout { height: calc(100vh - 64px); }
      .form-col { width: 480px; min-width: 380px; height: 100%; overflow-y: auto; }
      .preview-col { height: 100%; overflow: hidden; }
      .mobile-view-toggle { display: none; }
      .form-col, .preview-col { display: flex !important; }
    }

    /* Mobile layout */
    @media (max-width: 1023px) {
      .main-layout { height: calc(100vh - 112px); }
      .form-col { width: 100%; overflow-y: auto; height: 100%; }
      .preview-col { width: 100%; height: 100%; overflow: hidden; }
      .preview-col.mobile-hidden { display: none !important; }
      .form-col.mobile-hidden { display: none !important; }
    }
  </style>
</head>
<body class="bg-gray-50 font-sans">

<!-- ═══ TOP NAV ═══ -->
<nav class="bg-white border-b border-gray-100 shadow-sm z-10">
  <div class="h-14 flex items-center px-3 sm:px-6 gap-2 sm:gap-4">

    <!-- Logo -->
    <div class="flex items-center gap-2 shrink-0">
      <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center shadow">
        <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      </div>
      <span class="text-base font-bold text-gray-900">Resume<span class="text-brand-600">Forge</span></span>
    </div>

    <div class="flex-1"></div>

    <!-- ATS Score Ring -->
    <div class="flex items-center gap-2 px-2 sm:px-3 py-1.5 rounded-xl bg-gray-50 border border-gray-100">
      <svg width="36" height="36" viewBox="0 0 44 44">
        <circle cx="22" cy="22" r="18" fill="none" stroke="#e5e7eb" stroke-width="4"/>
        <circle id="atsRing" cx="22" cy="22" r="18" fill="none" stroke="#6366f1" stroke-width="4"
                stroke-linecap="round" stroke-dasharray="113.1" stroke-dashoffset="113.1"
                transform="rotate(-90 22 22)" class="ats-ring"/>
        <text id="atsScoreText" x="22" y="26" text-anchor="middle" font-size="11" font-weight="700" fill="#1e1b4b">0%</text>
      </svg>
      <div class="hidden sm:block">
        <div class="text-xs font-semibold text-gray-700">ATS Score</div>
        <div id="atsLabel" class="text-xs text-gray-400">Fill in your info</div>
      </div>
    </div>

    <!-- Refresh (desktop only) -->
    <button onclick="refreshPreview()" class="btn-ghost hidden lg:inline-flex">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
      Refresh
    </button>

    <!-- Download -->
    <button onclick="downloadPDF()" class="btn-primary text-xs sm:text-sm px-3 sm:px-5">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
      </svg>
      <span class="hidden sm:inline">Download PDF</span>
      <span class="sm:hidden">PDF</span>
    </button>
  </div>

  <!-- Mobile: Edit / Preview toggle bar -->
  <div class="mobile-view-toggle lg:hidden flex gap-1 bg-gray-100 p-1 mx-3 mb-2 rounded-xl text-xs font-medium">
    <button id="mobileEditBtn" class="tab-btn active flex-1 py-1.5 rounded-lg text-center transition" onclick="switchMobileView('edit')">
      Edit Form
    </button>
    <button id="mobilePreviewBtn" class="tab-btn flex-1 py-1.5 rounded-lg text-center text-gray-500 transition" onclick="switchMobileView('preview')">
      Preview Resume
    </button>
  </div>
</nav>

<!-- ═══ MAIN LAYOUT ═══ -->
<div class="main-layout flex flex-col lg:flex-row">

  <!-- ── LEFT: FORM ── -->
  <div id="formCol" class="form-col flex flex-col bg-gray-50 border-r border-gray-100 px-3 sm:px-4 py-4">

    <!-- Section Tabs -->
    <div class="flex gap-1 bg-gray-100 p-1 rounded-xl mb-4 text-xs font-medium shrink-0">
      <button class="tab-btn active flex-1 py-1.5 rounded-lg text-center transition" onclick="switchTab('basics')">Basics</button>
      <button class="tab-btn flex-1 py-1.5 rounded-lg text-center text-gray-500 transition" onclick="switchTab('experience')">Work</button>
      <button class="tab-btn flex-1 py-1.5 rounded-lg text-center text-gray-500 transition" onclick="switchTab('education')">Edu</button>
      <button class="tab-btn flex-1 py-1.5 rounded-lg text-center text-gray-500 transition" onclick="switchTab('skills')">Skills</button>
      <button class="tab-btn flex-1 py-1.5 rounded-lg text-center text-gray-500 transition" onclick="switchTab('extras')">Extras</button>
    </div>

    <!-- ── BASICS ── -->
    <div id="tab-basics" class="flex-1 overflow-y-auto">
      <div class="form-section">
        <div class="section-header">
          <span class="section-title">
            <svg class="w-4 h-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            Personal Information
          </span>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="col-span-2">
            <label class="field-label">Full Name *</label>
            <input id="fullName" class="field-input" type="text" placeholder="e.g. Sarah Johnson" oninput="updateAts()"/>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <label class="field-label">Job Title / Target Role *</label>
            <input id="jobTitle" class="field-input" type="text" placeholder="e.g. Senior Software Engineer" oninput="updateAts()"/>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <label class="field-label">Email *</label>
            <input id="email" class="field-input" type="email" placeholder="sarah@email.com" oninput="updateAts()"/>
          </div>
          <div>
            <label class="field-label">Phone</label>
            <input id="phone" class="field-input" type="text" placeholder="+1 (555) 000-0000"/>
          </div>
          <div>
            <label class="field-label">Location</label>
            <input id="location" class="field-input" type="text" placeholder="San Francisco, CA"/>
          </div>
          <div>
            <label class="field-label">LinkedIn URL</label>
            <input id="linkedin" class="field-input" type="text" placeholder="linkedin.com/in/sarah"/>
          </div>
          <div>
            <label class="field-label">GitHub / Portfolio</label>
            <input id="website" class="field-input" type="text" placeholder="github.com/sarah"/>
          </div>
        </div>
      </div>

      <div class="form-section">
        <div class="section-header">
          <span class="section-title">
            <svg class="w-4 h-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Professional Summary *
          </span>
        </div>
        <p class="text-xs text-gray-400 mb-2">3–4 sentences. Lead with your title, years of experience, top 2 skills, and biggest impact.</p>
        <textarea id="summary" class="field-textarea" rows="5"
          placeholder="Results-driven Software Engineer with 5+ years of experience building scalable distributed systems. Proven track record of delivering high-impact features at Google-scale, reducing latency by 40% and increasing reliability to 99.99% SLA. Expert in Go, Kubernetes, and distributed tracing. Passionate about developer experience and mentoring junior engineers."
          oninput="updateAts()"></textarea>
        <div id="summaryCount" class="text-right text-xs text-gray-300 mt-1">0 words</div>
      </div>
    </div>

    <!-- ── EXPERIENCE ── -->
    <div id="tab-experience" class="hidden flex-1 overflow-y-auto">
      <div class="form-section">
        <div class="section-header">
          <span class="section-title">
            <svg class="w-4 h-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            Work Experience
          </span>
        </div>
        <p class="text-xs text-gray-400 mb-3">Use action verbs + metrics: "Increased revenue by 30%", "Led team of 8 engineers"</p>
        <div id="experienceList"></div>
        <button class="add-btn w-full justify-center mt-2" onclick="addExperience()">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Add Work Experience
        </button>
      </div>
    </div>

    <!-- ── EDUCATION ── -->
    <div id="tab-education" class="hidden flex-1 overflow-y-auto">
      <div class="form-section">
        <div class="section-header">
          <span class="section-title">
            <svg class="w-4 h-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 14l9-5-9-5-9 5 9 5z"/><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>
            Education
          </span>
        </div>
        <div id="educationList"></div>
        <button class="add-btn w-full justify-center mt-2" onclick="addEducation()">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Add Education
        </button>
      </div>
    </div>

    <!-- ── SKILLS ── -->
    <div id="tab-skills" class="hidden flex-1 overflow-y-auto">
      <div class="form-section">
        <div class="section-header">
          <span class="section-title">
            <svg class="w-4 h-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
            Skills
          </span>
        </div>
        <p class="text-xs text-gray-400 mb-3">ATS scans for exact keyword matches. Add skills that appear in job descriptions.</p>
        <div id="skillCategories"></div>
        <button class="add-btn w-full justify-center mt-2" onclick="addSkillCategory()">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Add Skill Category
        </button>
      </div>
    </div>

    <!-- ── EXTRAS ── -->
    <div id="tab-extras" class="hidden flex-1 overflow-y-auto">
      <div class="form-section">
        <div class="section-header">
          <span class="section-title">
            <svg class="w-4 h-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
            Projects
          </span>
        </div>
        <div id="projectList"></div>
        <button class="add-btn w-full justify-center mt-2" onclick="addProject()">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Add Project
        </button>
      </div>
      <div class="form-section">
        <div class="section-header">
          <span class="section-title">
            <svg class="w-4 h-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
            Certifications & Awards
          </span>
        </div>
        <div id="certList"></div>
        <button class="add-btn w-full justify-center mt-2" onclick="addCert()">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Add Certification
        </button>
      </div>
    </div>

    <!-- ATS Tips -->
    <div class="bg-gradient-to-br from-brand-50 to-indigo-50 border border-brand-100 rounded-2xl p-4 mt-2 shrink-0">
      <div class="flex items-center gap-2 mb-2">
        <svg class="w-4 h-4 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span class="text-xs font-semibold text-brand-800">ATS Optimization Tips</span>
      </div>
      <ul class="text-xs text-brand-700 space-y-1.5">
        <li class="flex gap-1.5"><span class="text-brand-400 mt-0.5">›</span> Use keywords from the job description verbatim</li>
        <li class="flex gap-1.5"><span class="text-brand-400 mt-0.5">›</span> Quantify every achievement with numbers/percentages</li>
        <li class="flex gap-1.5"><span class="text-brand-400 mt-0.5">›</span> Standard section names: "Work Experience", "Education", "Skills"</li>
        <li class="flex gap-1.5"><span class="text-brand-400 mt-0.5">›</span> No tables, columns, or graphics in the PDF</li>
      </ul>
    </div>

    <!-- Developer Credit -->
    <div class="flex items-center justify-center gap-1.5 pt-3 pb-1 shrink-0">
      <span class="text-xs text-gray-400">Built by</span>
      <a href="https://www.linkedin.com/in/elvin-jhon-gimena-4b2665144/"
         target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-800 transition-colors">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        Elvin Jhon Gimena
      </a>
    </div>

  </div><!-- /form col -->

  <!-- ── RIGHT: PREVIEW ── -->
  <div id="previewCol" class="preview-col mobile-hidden flex-1 flex flex-col bg-gray-200">
    <div class="flex items-center justify-between px-4 py-2 bg-gray-100 border-b border-gray-200 shrink-0">
      <span class="text-xs font-medium text-gray-500">Live Preview — A4 Format</span>
      <div class="flex items-center gap-3">
        <span class="text-xs text-gray-400 hidden sm:inline">PDF output is identical</span>
        <button onclick="refreshPreview()" class="btn-ghost lg:hidden text-xs">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          Refresh
        </button>
      </div>
    </div>
    <div class="flex-1 overflow-auto flex justify-center items-start py-4 sm:py-6">
      <div class="bg-white shadow-2xl" style="width:794px; min-height:1123px;">
        <iframe id="previewFrame" class="preview-frame" style="width:794px;height:1123px;"></iframe>
      </div>
    </div>
  </div>

</div><!-- /main layout -->

<!-- Hidden form for reliable binary PDF download -->
<form id="pdfForm" action="/generate-pdf" method="POST" style="display:none">
  <input type="hidden" id="pdfJsonData" name="jsonData">
</form>

<!-- PDF loading overlay -->
<div id="pdfOverlay" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center">
  <div class="bg-white rounded-2xl p-8 flex flex-col items-center gap-4 shadow-2xl mx-4">
    <div class="w-12 h-12 border-4 border-brand-100 border-t-brand-600 rounded-full animate-spin"></div>
    <div class="text-sm font-semibold text-gray-700">Generating your ATS-ready PDF…</div>
    <div class="text-xs text-gray-400">This takes a few seconds</div>
  </div>
</div>

<script src="/js/app.js"></script>
</body>
</html>
